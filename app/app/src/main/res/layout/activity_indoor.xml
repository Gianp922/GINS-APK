<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">

    <TextView android:id="@+id/tvIndoor"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:text="室内TDOA定位"/>

    <com.gnss.locator.RelativePlotView android:id="@+id/xyView"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button android:id="@+id/btnBack" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="返回"/>
</LinearLayout>
